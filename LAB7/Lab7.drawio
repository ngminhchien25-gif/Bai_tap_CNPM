      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n  classDef actor fill:#FFFFFF,stroke:#B03060,color:#000\n  classDef uc fill:#FFFBD6,stroke:#B03060,color:#000\n\n  %% ACTORS\n  HR[\&quot;Human Resources\\n(HR)\&quot;]:::actor\n  GD[\&quot;Giám đốc\\n(GĐ)\&quot;]:::actor\n  TP[\&quot;Trưởng phòng\\n(TP)\&quot;]:::actor\n\n  %% SYSTEM BOUNDARY\n  subgraph HT [\&quot;Quy trình: Nhận vào thử việc -&gt; Ký hợp đồng chính thức\&quot;]\n    direction TB\n\n    %% Main Use Cases (Chức năng chính)\n    UC01([\&quot;UC01 Lập hồ sơ nhân viên\&quot;]):::uc\n    UC02([\&quot;UC02 Lập quyết định tuyển dụng\&quot;]):::uc\n    UC03([\&quot;UC03 Duyệt &amp; Ký quyết định tuyển dụng\&quot;]):::uc\n    UC04([\&quot;UC04 Đánh giá thử việc\&quot;]):::uc\n    UC05([\&quot;UC05 Ký hợp đồng chính thức\&quot;]):::uc\n    UC06([\&quot;UC06 Lập quyết định lương &amp; phụ cấp\&quot;]):::uc\n    UC07([\&quot;UC07 Lập quyết định chức vụ\&quot;]):::uc\n\n    %% Sub/Included/Extended Use Cases (Các chức năng phân rã chuẩn)\n    UC_CCCD([\&quot;Xác thực &amp; Kiểm tra CCCD\&quot;]):::uc\n    UC_NGHIVIEC([\&quot;Chấm dứt thử việc\\n(Chuyển trạng thái nghỉ việc)\&quot;]):::uc\n    UC_BHXH([\&quot;Lập hồ sơ BHYT / BHXH\&quot;]):::uc\n    UC_DUYET_HD([\&quot;Duyệt &amp; Ký hợp đồng\&quot;]):::uc\n  end\n\n  %% ACTOR CONNECTIONS (Liên kết Actor với Use Case)\n  HR --&gt; UC01\n  HR --&gt; UC02\n  HR --&gt; UC05\n  HR --&gt; UC06\n  HR --&gt; UC07\n\n  GD --&gt; UC03\n  GD --&gt; UC05\n\n  TP --&gt; UC04\n\n  %% USE CASE RELATIONSHIPS (Quan hệ giữa các Use Case theo chuẩn)\n  \n  %% Lập hồ sơ nhân viên luôn bao gồm việc kiểm tra tính hợp lệ CCCD\n  UC01 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC_CCCD\n\n  %% Ký hợp đồng chính thức luôn bao gồm bước duyệt/ký của GĐ\n  UC05 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC_DUYET_HD\n\n  %% Đánh giá thử việc mở rộng sang Chấm dứt thử việc khi kết quả không đạt\n  UC04 &lt;-. \&quot;&lt;&lt;extend&gt;&gt;\\n[không đạt]\&quot; .- UC_NGHIVIEC\n\n  %% Ký hợp đồng chính thức mở rộng sang Lập hồ sơ BHXH nếu là hợp đồng dài hạn\n  UC05 &lt;-. \&quot;&lt;&lt;extend&gt;&gt;\\n[hợp đồng dài hạn]\&quot; .- UC_BHXH&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="nX52K8DL7VBkcxyvlw7u-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
