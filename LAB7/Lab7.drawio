        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n \nclass PhongBan {\n  +maPB : string PK\n  +tenPB : string\n  +moTa : string\n  +themPB()\n  +suaPB()\n  +xoaPB()\n}\nclass NhanVien {\n  +maNV : string PK\n  +hoTen : string\n  +ngaySinh : date\n  +gioiTinh : string\n  +diaChi : string\n  +soDienThoai : string\n  +themNV()\n  +suaNV()\n  +timKiemNV()\n}\nclass ChucVu {\n  +maCV : string PK\n  +tenCV : string\n  +phuCapChucVu : decimal\n}\nclass QuyetDinh {\n  +soQD : string PK\n  +ngayLap : date\n  +ngayHieuLuc : date\n  +noiDung : string\n  +nguoiKy : string\n  +lapQD()\n  +duyetQD()\n}\nclass QDTuyenDung {\n  +thoiGianThuViec : int\n  +luongThuViec : decimal\n  +dieuKhoanHaiBen : string\n}\nclass QDChucVu {\n  +phuCapChucVu : decimal\n}\nclass QDLuong {\n  +luongCoBan : decimal\n  +phuCapLuong : decimal\n  +phuCapDocHai : decimal\n}\nclass QDKhenThuong {\n  +hinhThuc : string\n  +lyDo : string\n  +tongTien : decimal\n}\nclass QDKyLuat {\n  +hinhThucKyLuat : string\n  +lyDo : string\n  +tongTienPhat : decimal\n}\nclass ChiTietKhenThuong {\n  +soTien : decimal\n  +loaiDoiTuong : string\n}\nclass ChiTietKyLuat {\n  +soTienPhat : decimal\n  +loaiDoiTuong : string\n}\nclass PhieuChiKhenThuong {\n  +soPhieuChi : string PK\n  +ngayChi : date\n  +soTien : decimal\n  +lapPhieuChi()\n}\nclass PhieuThuNopPhat {\n  +soPhieuThu : string PK\n  +ngayThu : date\n  +soTien : decimal\n  +hinhThucNop : string\n  +lapPhieuThu()\n}\nclass HopDong {\n  +soHD : string PK\n  +ngayKy : date\n  +ngayBatDau : date\n  +ngayKetThuc : date\n  +kyHopDong()\n}\nclass HopDongDaiHan {\n  +lapHoSoBaoHiem()\n}\nclass HopDongNganHan {\n}\nclass BaoHiem {\n  +maBH : string PK\n  +loaiBH : string\n  +soSo : string\n  +mucDong : decimal\n}\nclass CaLamViec {\n  +maCa : string PK\n  +tenCa : string\n  +gioBatDau : time\n  +gioKetThuc : time\n}\nclass KeHoachPhanCong {\n  +maKH : string PK\n  +tuan : int\n  +ngayLap : date\n  +lapKeHoach()\n}\nclass ChiTietPhanCong {\n  +ngayLam : date\n  +coPhuTroi : boolean\n}\nclass BangChamCong {\n  +soBCC : string PK\n  +thang : int\n  +nam : int\n  +chamCong()\n}\nclass ChiTietChamCong {\n  +ngay : date\n  +soGioLam : float\n  +trangThai : string\n}\nclass PhieuPhuTroi {\n  +soPhieu : string PK\n  +ngayPhuTroi : date\n  +soGioPhuTroi : float\n  +hinhThuc : string\n  +heSo : float\n}\nclass ChiTietPhuTroi {\n  +soGio : float\n}\nclass BangLuong {\n  +maBL : string PK\n  +thang : int\n  +nam : int\n  +tinhLuong()\n}\nclass ChiTietBangLuong {\n  +luongCoBan : decimal\n  +tongPhuCap : decimal\n  +tienPhuTroi : decimal\n  +khauTruBHYT : decimal\n  +khauTruBHXH : decimal\n  +tienThuong : decimal\n  +tienPhat : decimal\n  +thucLanh : decimal\n}\n \nPhongBan \&quot;1\&quot; -- \&quot;1..*\&quot; NhanVien : có\nNhanVien \&quot;1\&quot; -- \&quot;1\&quot; QDTuyenDung : được tuyển\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QDTuyenDung : cần tuyển\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDong : ký\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QDChucVu : được bổ nhiệm\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; QDChucVu : theo\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QDLuong : được hưởng\n \nQuyetDinh &lt;|-- QDTuyenDung\nQuyetDinh &lt;|-- QDChucVu\nQuyetDinh &lt;|-- QDLuong\nQuyetDinh &lt;|-- QDKhenThuong\nQuyetDinh &lt;|-- QDKyLuat\n \nHopDong &lt;|-- HopDongDaiHan\nHopDong &lt;|-- HopDongNganHan\nHopDongDaiHan \&quot;1\&quot; -- \&quot;1..*\&quot; BaoHiem : có\n \nQDKhenThuong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietKhenThuong\nChiTietKhenThuong \&quot;*\&quot; -- \&quot;0..1\&quot; NhanVien : cá nhân\nChiTietKhenThuong \&quot;*\&quot; -- \&quot;0..1\&quot; PhongBan : tập thể\nQDKhenThuong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuChiKhenThuong : chi qua\n \nQDKyLuat \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietKyLuat\nChiTietKyLuat \&quot;*\&quot; -- \&quot;0..1\&quot; NhanVien : cá nhân\nChiTietKyLuat \&quot;*\&quot; -- \&quot;0..1\&quot; PhongBan : tập thể\nQDKyLuat \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuThuNopPhat : thu qua\n \nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachPhanCong : lập\nKeHoachPhanCong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhanCong\nChiTietPhanCong \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nChiTietPhanCong \&quot;*\&quot; -- \&quot;1\&quot; CaLamViec\n \nBangChamCong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietChamCong\nChiTietChamCong \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhuTroi\nChiTietPhuTroi \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\n \nBangLuong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietBangLuong\nChiTietBangLuong \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nBangLuong ..&gt; BangChamCong : dựa vào\nBangLuong ..&gt; PhieuPhuTroi : dựa vào\nBangLuong ..&gt; QDLuong : dựa vào\nBangLuong ..&gt; QDChucVu : dựa vào\nBangLuong ..&gt; PhieuThuNopPhat : trừ lương&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="iW00rY-Qoqjy6P6BD-fJ-1">
