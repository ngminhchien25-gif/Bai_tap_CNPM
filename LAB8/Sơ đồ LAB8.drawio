        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor KT as Kế toán\n    participant GUI as frmBangLuong\n    participant SVC as LuongService\n    participant DB as Database (Db)\n\n    KT-&gt;&gt;GUI: Chọn tháng, năm và bấm \&quot;Tính lương\&quot;[cite: 2]\n    GUI-&gt;&gt;SVC: tinhLuong(thang, nam)[cite: 2]\n    SVC-&gt;&gt;DB: kiemTraDaChot(thang, nam)[cite: 2]\n    DB--&gt;&gt;SVC: Trạng thái BangChamCong (DaChot / Chưa chốt)[cite: 2]\n    \n    alt Chấm công chưa chốt hoàn toàn (Vi phạm QD07)[cite: 2]\n        SVC--&gt;&gt;GUI: Result(lỗi: còn bảng chấm công chưa chốt)[cite: 2]\n        GUI--&gt;&gt;KT: Hiển thị thông báo từ chối tính lương[cite: 2]\n    else Đã chốt đầy đủ[cite: 2]\n        SVC-&gt;&gt;DB: layDuLieu(thang, nam) (QDLuong, QĐ chức vụ, công, phụ trội, thưởng, phạt, BH)[cite: 2]\n        DB--&gt;&gt;SVC: Trả về tập dữ liệu thô[cite: 2]\n        loop Duyệt qua từng nhân viên[cite: 2]\n            SVC-&gt;&gt;SVC: tinhThucLinh() theo công thức chuẩn QD01[cite: 2]\n        end\n        SVC-&gt;&gt;DB: luuBangLuong() (INSERT BangLuong, ChiTietBangLuong trong Transaction)[cite: 2]\n        DB--&gt;&gt;SVC: OK[cite: 2]\n        SVC--&gt;&gt;GUI: Result(DataTable bảng lương)[cite: 2]\n        GUI--&gt;&gt;KT: Hiển thị bảng lương chi tiết lên DataGridView[cite: 2]\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="3ZV84XhsUrjsixfbpEiJ-84">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
